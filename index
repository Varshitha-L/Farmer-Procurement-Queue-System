function FarmerAuth({db,setDB,t,lang,setLang,onLogin,go}){
  const [mode,setMode] = useState("login");
  const [err,setErr] = useState("");
  const [busy,setBusy] = useState(false);
  const [f,setF] = useState({phone:"",pin:"",pin2:"",name:"",village:"",crop:"Paddy",acres:"",aadhaar:"",bank:""});
  const set = (k,v) => setF(p=>({...p,[k]:v}));

  async function doLogin(){
    setErr("");
    if(!/^\d{10}$/.test(f.phone)) return setErr(t("errPhone"));
    if(!/^\d{4}$/.test(f.pin)) return setErr(t("errPin"));
    setBusy(true);
    let found = null;
    for(const fr of db.farmers){
      const ph = await decField(fr.phoneEnc);
      if(ph === f.phone){ found = fr; break; }
    }
    if(!found){ setBusy(false); return setErr(t("errNoUser")); }
    const ok = await verifyPin(f.pin, found.pinSalt, found.pinHash);
    setBusy(false);
    if(!ok) return setErr(t("errWrong"));
    if(found.lang) setLang(found.lang);
    onLogin(found.id);
  }

  async function doRegister(){
    setErr("");
    if(!f.name.trim()) return setErr(t("errName"));
    if(!/^\d{10}$/.test(f.phone)) return setErr(t("errPhone"));
    if(!/^\d{4}$/.test(f.pin)) return setErr(t("errPin"));
    if(f.pin !== f.pin2) return setErr(t("errPinMatch"));
    setBusy(true);
    for(const fr of db.farmers){
      if(await decField(fr.phoneEnc) === f.phone){ setBusy(false); return setErr(t("errExists")); }
    }
    const {salt,hash} = await hashPin(f.pin);
    const rec = {
      id:uid("f"), name:f.name.trim(), village:f.village.trim(), crop:f.crop, acres:f.acres, lang,
      phoneEnc: await encField(f.phone), phoneMask: maskTail(f.phone,4),
      aadhaarEnc: await encField(f.aadhaar), aadhaarMask: maskTail(f.aadhaar,4),
      bankEnc: await encField(f.bank), bankMask: maskTail(f.bank,4),
      pinSalt:salt, pinHash:hash, createdAt:Date.now()
    };
    setDB(d=>{ const n={...d, farmers:[...d.farmers, rec]}; return n; });
    setBusy(false);
    onLogin(rec.id);
  }

  return (
    <div className="narrow" style={{paddingTop:26,maxWidth:520}}>
      <button className="btn ghost sm" onClick={()=>go("landing")}>← {t("back")}</button>
      <div className="card" style={{marginTop:14}}>
        <h2>{mode==="login"?t("farmerLogin"):t("farmerRegister")}</h2>
        <p className="small muted">{mode==="login" ? "Demo: 9845012301 · PIN 1111" : t("tagline")}</p>
        <hr className="sep"/>
        {mode==="register" && <>
          <label className="field"><span>{t("name")}</span>
            <input className="input" value={f.name} onChange={e=>set("name",e.target.value)} /></label>
          <div className="grid g2">
            <label className="field"><span>{t("village")}</span>
              <input className="input" value={f.village} onChange={e=>set("village",e.target.value)} /></label>
            <label className="field"><span>{t("crop")}</span>
              <select className="input" value={f.crop} onChange={e=>set("crop",e.target.value)}>
                <option>Paddy</option><option>Wheat</option><option>Ragi</option><option>Maize</option><option>Jowar</option>
              </select></label>
          </div>
        </>}
        <label className="field"><span>{t("phone")}</span>
          <input className="input mono" inputMode="numeric" maxLength={10} value={f.phone}
            onChange={e=>set("phone",e.target.value.replace(/\D/g,""))} placeholder="9876543210" /></label>
        {mode==="register" && <div className="grid g2">
          <label className="field"><span>{t("acres")}</span>
            <input className="input" inputMode="decimal" value={f.acres} onChange={e=>set("acres",e.target.value)} /></label>
          <label className="field"><span>{t("aadhaar")}</span>
            <input className="input mono" inputMode="numeric" maxLength={12} value={f.aadhaar}
              onChange={e=>set("aadhaar",e.target.value.replace(/\D/g,""))} /></label>
        </div>}
        {mode==="register" &&
          <label className="field"><span>{t("bank")}</span>
            <input className="input mono" value={f.bank} onChange={e=>set("bank",e.target.value)} /></label>}
        <div className="grid g2">
          <label className="field"><span>{t("pin")}</span>
            <input className="input mono" type="password" inputMode="numeric" maxLength={4} value={f.pin}
              onChange={e=>set("pin",e.target.value.replace(/\D/g,""))} /></label>
          {mode==="register" &&
            <label className="field"><span>{t("confirmPin")}</span>
              <input className="input mono" type="password" inputMode="numeric" maxLength={4} value={f.pin2}
                onChange={e=>set("pin2",e.target.value.replace(/\D/g,""))} /></label>}
        </div>
        {err && <div className="notice small" style={{marginBottom:12,borderColor:"var(--bad)",background:"var(--bad-soft)",color:"var(--bad)"}}>{err}</div>}
        <button className="btn block" disabled={busy} onClick={mode==="login"?doLogin:doRegister}>
          {busy ? "…" : (mode==="login"?t("login"):t("createAccount"))}
        </button>
        <p className="small" style={{textAlign:"center",marginTop:12,marginBottom:0}}>
          <a href="#" onClick={e=>{e.preventDefault();setErr("");setMode(mode==="login"?"register":"login");}}>
            {mode==="login"?t("newHere"):t("haveAccount")}
          </a>
        </p>
      </div>
    </div>
  );
}

