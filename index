/* ============================================================
   2. ENCRYPTION LAYER  (Web Crypto API)
   PIN  -> PBKDF2-SHA256, 150k iterations, per-user random salt
   PII  -> AES-GCM 256, per-field random 96-bit IV
   ============================================================ */
const SC = window.crypto && window.crypto.subtle;
const enc = new TextEncoder(), dec = new TextDecoder();
const b64 = buf => btoa(String.fromCharCode(...new Uint8Array(buf)));
const unb64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const randHex = n => Array.from(crypto.getRandomValues(new Uint8Array(n))).map(b=>b.toString(16).padStart(2,"0")).join("");

const KDF_ITER = 150000;

async function hashPin(pin, saltHex){
  const salt = saltHex || randHex(16);
  const base = await SC.importKey("raw", enc.encode(pin), "PBKDF2", false, ["deriveBits"]);
  const bits = await SC.deriveBits({name:"PBKDF2", salt:enc.encode(salt), iterations:KDF_ITER, hash:"SHA-256"}, base, 256);
  return {salt, hash:b64(bits)};
}
async function verifyPin(pin, saltHex, expected){
  const {hash} = await hashPin(pin, saltHex);
  // constant-time-ish compare
  if(hash.length !== expected.length) return false;
  let diff = 0;
  for(let i=0;i<hash.length;i++) diff |= hash.charCodeAt(i) ^ expected.charCodeAt(i);
  return diff === 0;
}

let AES_KEY = null;
async function initKey(){
  let keySalt = null;
  try{ keySalt = localStorage.getItem("as.keysalt"); }catch(e){}
  if(!keySalt){ keySalt = randHex(16); try{ localStorage.setItem("as.keysalt", keySalt); }catch(e){} }
  // In production this master secret lives in a KMS / HSM on the server, never in the client.
  const base = await SC.importKey("raw", enc.encode("annadata-setu::field-encryption::v1"), "PBKDF2", false, ["deriveKey"]);
  AES_KEY = await SC.deriveKey(
    {name:"PBKDF2", salt:enc.encode(keySalt), iterations:KDF_ITER, hash:"SHA-256"},
    base, {name:"AES-GCM", length:256}, false, ["encrypt","decrypt"]
  );
}
async function encField(plain){
  if(plain === undefined || plain === null || plain === "") return "";
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = await SC.encrypt({name:"AES-GCM", iv}, AES_KEY, enc.encode(String(plain)));
  return b64(iv) + ":" + b64(ct);
}
async function decField(blob){
  if(!blob) return "";
  try{
    const [ivS, ctS] = blob.split(":");
    const pt = await SC.decrypt({name:"AES-GCM", iv:unb64(ivS)}, AES_KEY, unb64(ctS));
    return dec.decode(pt);
  }catch(e){ return "—"; }
}
const maskTail = (s,n=4) => s ? "•".repeat(Math.max(0,s.length-n)) + s.slice(-n) : "";

