<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Annadata Setu — Procurement Centre Queue &amp; Payment Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;700&family=Noto+Sans+Kannada:wght@400;500;700&family=Noto+Sans+Gurmukhi:wght@400;500;700&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --page:#E8EBE1; --surface:#FFFFFF; --surface-2:#F3F5EE; --sunk:#DDE2D4;
  --ink:#17211B; --muted:#5C6B5F; --line:#CBD3C1;
  --green:#1B5E3A; --green-2:#25764A; --turmeric:#D98324; --turmeric-soft:#FBEBD6;
  --ok:#1B7A44; --ok-soft:#DFF0E4; --warn:#9A6207; --warn-soft:#FBEED2;
  --bad:#A32B20; --bad-soft:#F7DFDC; --board:#12241A; --board-text:#F2C14E;
  --r-card:14px; --r-pill:999px;
  --shadow:0 1px 2px rgba(23,33,27,.08), 0 8px 24px -14px rgba(23,33,27,.35);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --page:#111A14; --surface:#18231C; --surface-2:#1E2B23; --sunk:#0D150F;
    --ink:#E8EEE6; --muted:#9AAB9E; --line:#2C3C32;
    --green:#5FBF8A; --green-2:#7FD3A3; --turmeric:#E8A24E; --turmeric-soft:#3A2A14;
    --ok:#69C48F; --ok-soft:#16301F; --warn:#E0B357; --warn-soft:#33270D;
    --bad:#E9897C; --bad-soft:#3A1C18; --board:#0A140E; --board-text:#F2C14E;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 26px -16px rgba(0,0,0,.8);
  }
}
:root[data-theme="dark"]{
  --page:#111A14; --surface:#18231C; --surface-2:#1E2B23; --sunk:#0D150F;
  --ink:#E8EEE6; --muted:#9AAB9E; --line:#2C3C32;
  --green:#5FBF8A; --green-2:#7FD3A3; --turmeric:#E8A24E; --turmeric-soft:#3A2A14;
  --ok:#69C48F; --ok-soft:#16301F; --warn:#E0B357; --warn-soft:#33270D;
  --bad:#E9897C; --bad-soft:#3A1C18; --board:#0A140E; --board-text:#F2C14E;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 26px -16px rgba(0,0,0,.8);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--page); color:var(--ink); font-family:"Noto Sans","Noto Sans Devanagari","Noto Sans Kannada","Noto Sans Gurmukhi",system-ui,sans-serif;
  font-size:16px; line-height:1.55; -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4{font-family:Archivo,"Noto Sans",system-ui,sans-serif; line-height:1.15; margin:0; letter-spacing:-.015em; font-weight:700}
h1{font-size:clamp(28px,5vw,44px)} h2{font-size:clamp(20px,3vw,26px)} h3{font-size:18px} h4{font-size:15px}
p{margin:0 0 .7em} a{color:var(--green)}
:lang(hi) h1,:lang(kn) h1,:lang(pa) h1,:lang(mr) h1,
:lang(hi) h2,:lang(kn) h2,:lang(pa) h2,:lang(mr) h2{font-family:"Noto Sans Devanagari","Noto Sans Kannada","Noto Sans Gurmukhi","Noto Sans",sans-serif;letter-spacing:0}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--turmeric); outline-offset:2px; border-radius:4px}
.mono{font-family:"Roboto Mono",ui-monospace,monospace}

/* layout */
.wrap{max-width:1140px;margin:0 auto;padding:0 18px}
.narrow{max-width:760px;margin:0 auto;padding:0 18px}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.between{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.grid{display:grid;gap:14px}
@media(min-width:720px){.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}}
.stack>*+*{margin-top:14px}
.hide-sm{display:none}
@media(min-width:840px){.hide-sm{display:block}}

/* topbar */
.topbar{position:sticky;top:0;z-index:40;background:var(--surface);border-bottom:1px solid var(--line)}
.topbar-in{display:flex;align-items:center;gap:12px;justify-content:space-between;padding:10px 18px;max-width:1140px;margin:0 auto}
.brand{display:flex;align-items:center;gap:10px;font-family:Archivo;font-weight:700;font-size:17px;letter-spacing:-.02em}
.seal{width:32px;height:32px;border-radius:8px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:15px;flex:none}
.brand small{display:block;font-family:"Noto Sans";font-weight:400;font-size:11px;color:var(--muted);letter-spacing:0}

/* controls */
.btn{border:1px solid var(--green);background:var(--green);color:#fff;padding:10px 16px;border-radius:var(--r-pill);font-weight:600;cursor:pointer;font-size:15px}
.btn:hover{background:var(--green-2);border-color:var(--green-2)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--green);border-color:var(--line)}
.btn.ghost:hover{background:var(--surface-2)}
.btn.warn{background:var(--turmeric);border-color:var(--turmeric);color:#231403}
.btn.danger{background:transparent;color:var(--bad);border-color:var(--bad)}
.btn.sm{padding:6px 12px;font-size:13.5px}
.btn.block{width:100%;justify-content:center}
.field{display:block;margin-bottom:12px}
.field span{display:block;font-size:13.5px;color:var(--muted);margin-bottom:5px;font-weight:500}
.input,select.input,textarea.input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:var(--surface);}
.input:focus{border-color:var(--green)}
select.lang{padding:7px 10px;border-radius:var(--r-pill);border:1px solid var(--line);background:var(--surface-2);font-size:14px;font-weight:500}
.icon-btn{border:1px solid var(--line);background:var(--surface-2);width:34px;height:34px;border-radius:50%;cursor:pointer;display:grid;place-items:center;font-size:15px}

/* cards */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:18px;box-shadow:var(--shadow)}
.card.flat{box-shadow:none}
.card.tight{padding:14px}
.sunk{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:12px}
.tag{display:inline-block;padding:3px 10px;border-radius:var(--r-pill);font-size:12.5px;font-weight:600;background:var(--surface-2);border:1px solid var(--line)}
.tag.ok{background:var(--ok-soft);color:var(--ok);border-color:transparent}
.tag.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}
.tag.bad{background:var(--bad-soft);color:var(--bad);border-color:transparent}
.tag.info{background:var(--turmeric-soft);color:var(--warn);border-color:transparent}
.muted{color:var(--muted)}
.small{font-size:13.5px}
.tiny{font-size:12px}
hr.sep{border:0;border-top:1px dashed var(--line);margin:14px 0}

/* queue board — the hero */
.board{background:var(--board);border-radius:16px;padding:22px;color:#EFF3EA;position:relative;overflow:hidden}
.board:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 3px);pointer-events:none}
.board-label{font-size:12.5px;color:#9DB3A4;font-weight:600;margin-bottom:2px}
.board-num{font-family:"Roboto Mono";font-weight:700;font-size:clamp(40px,10vw,76px);color:var(--board-text);line-height:1;letter-spacing:.02em;text-shadow:0 0 22px rgba(242,193,78,.25)}
.board-grid{display:grid;gap:16px;grid-template-columns:1fr}
@media(min-width:680px){.board-grid{grid-template-columns:1.2fr 1fr}}
.board-mini{display:flex;gap:18px;flex-wrap:wrap}
.board-mini div b{display:block;font-family:"Roboto Mono";font-size:22px;color:#EFF3EA}
.board-mini div span{font-size:12px;color:#9DB3A4}

/* token slip */
.slip{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;position:relative}
.slip:after,.slip:before{content:"";position:absolute;width:16px;height:16px;border-radius:50%;background:var(--page);top:50%;transform:translateY(-50%);border:1px solid var(--line)}
.slip:before{left:-9px;border-right-color:transparent;clip-path:inset(0 0 0 50%)}
.slip:after{right:-9px;border-left-color:transparent;clip-path:inset(0 50% 0 0)}
.slip .tok{font-family:"Roboto Mono";font-weight:700;font-size:26px;letter-spacing:.04em}

/* progress / bars */
.bar{height:9px;background:var(--sunk);border-radius:var(--r-pill);overflow:hidden}
.bar i{display:block;height:100%;background:var(--green);border-radius:var(--r-pill);transition:width .5s ease}
.bar i.hot{background:var(--bad)} .bar i.mid{background:var(--turmeric)}

/* tabs */
.tabs{display:flex;gap:4px;overflow-x:auto;padding:6px;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-pill);scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{border:0;background:transparent;padding:8px 15px;border-radius:var(--r-pill);cursor:pointer;font-weight:600;font-size:14px;white-space:nowrap;color:var(--muted)}
.tabs button[aria-selected="true"]{background:var(--green);color:#fff}

/* table */
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:560px;font-size:14px}
th{text-align:left;font-weight:600;color:var(--muted);font-size:12.5px;padding:10px 12px;border-bottom:1px solid var(--line);background:var(--surface-2);white-space:nowrap}
td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
tr:last-child td{border-bottom:0}

/* steps */
.steps{display:flex;gap:0;flex-wrap:wrap}
.step{flex:1;min-width:96px;padding:9px 6px;border-top:4px solid var(--sunk);font-size:12.5px;color:var(--muted)}
.step.done{border-top-color:var(--green);color:var(--ink);font-weight:600}
.step.now{border-top-color:var(--turmeric);color:var(--ink);font-weight:700}

/* sms */
.sms{background:var(--surface-2);border:1px solid var(--line);border-left:4px solid var(--green);border-radius:0 10px 10px 0;padding:11px 13px}
.sms.unread{border-left-color:var(--turmeric);background:var(--turmeric-soft)}

/* misc */
.notice{background:var(--turmeric-soft);border:1px solid color-mix(in srgb,var(--turmeric) 40%,transparent);border-radius:10px;padding:11px 13px;font-size:14px}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--board);color:#fff;padding:12px 20px;border-radius:var(--r-pill);z-index:99;box-shadow:var(--shadow);font-weight:600;font-size:14.5px;max-width:92vw;text-align:center}
.slot{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:11px;cursor:pointer;text-align:left;width:100%}
.slot[aria-pressed="true"]{border-color:var(--green);background:var(--ok-soft);box-shadow:inset 0 0 0 1px var(--green)}
.slot:disabled{opacity:.5;cursor:not-allowed}
.kv{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:14px}
.kv:last-child{border-bottom:0}
.cipher{font-family:"Roboto Mono";font-size:11.5px;word-break:break-all;color:var(--muted);background:var(--sunk);padding:8px;border-radius:8px;max-height:96px;overflow:auto}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--turmeric);display:inline-block;animation:p 1.8s infinite}
@keyframes p{0%,100%{opacity:1}50%{opacity:.25}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.footer{padding:26px 0;color:var(--muted);font-size:13px;border-top:1px solid var(--line);margin-top:34px}
</style>
</head>
