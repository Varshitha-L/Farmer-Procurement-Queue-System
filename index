function BookSlot({db,setDB,t,lang,me,toast,setTab}){
  const [cid,setCid] = useState(db.centres[0]?db.centres[0].id:"");
  const [date,setDate] = useState(todayISO());
  const [slot,setSlot] = useState("");
  const [qty,setQty] = useState("");
  const [err,setErr] = useState("");
  const c = centreById(db,cid);

  function confirm(){
    setErr("");
    if(!slot) return setErr(t("errSlot"));
    if(!qty || Number(qty)<=0) return setErr(t("errQty"));
    if(slotCount(db,cid,date,slot) >= c.perSlot) return setErr(t("errFull"));
    setDB(d=>{
      const n = {...d, bookings:[...d.bookings], notes:[...d.notes], seq:{...d.seq}};
      const key = cid+"|"+date;
      const seq = (n.seq[key]||0)+1; n.seq[key]=seq;
      const dd = date.slice(8,10)+date.slice(5,7);
      const token = c.code+"-"+dd+"-"+String(seq).padStart(3,"0");
      const bk = {id:uid("b"), farmerId:me.id, centreId:cid, date, slot, seq, token,
        status:"booked", expQty:Number(qty), rate:c.rate, createdAt:Date.now()};
      n.bookings.push(bk);
      pushNote(n, me.id, makeT(me.lang||lang)("msgBooked",{c:c.name,d:fmtDate(date,me.lang||lang),t:slot,k:token}), "sms");
      return n;
    });
    toast(t("bookingDone"));
    setTab("home");
  }

  return (
    <div className="stack">
      <h2>{t("bookAt")}</h2>
      <div className="card">
        <label className="field"><span>{t("step1")}</span>
          <select className="input" value={cid} onChange={e=>{setCid(e.target.value);setSlot("");}}>
            {db.centres.map(x=><option key={x.id} value={x.id}>{x.name} — {x.crop}</option>)}
          </select></label>
        {c && <StorageBar c={c} t={t}/>}
      </div>
      <div className="card">
        <span className="small muted" style={{fontWeight:500}}>{t("step2")}</span>
        <div className="row" style={{marginTop:8,gap:8}}>
          {dayList().map(d=>(
            <button key={d} className="slot" style={{width:"auto",minWidth:76,textAlign:"center"}}
              aria-pressed={date===d} onClick={()=>{setDate(d);setSlot("");}}>
              <b>{fmtDate(d,lang)}</b>
            </button>
          ))}
        </div>
      </div>
      <div className="card">
        <span className="small muted" style={{fontWeight:500}}>{t("step3")}</span>
        <div className="grid g2" style={{marginTop:8}}>
          {TIME_SLOTS.map(s=>{
            const used = slotCount(db,cid,date,s), left = (c?c.perSlot:0)-used, full = left<=0;
            return (
              <button key={s} className="slot" aria-pressed={slot===s} disabled={full} onClick={()=>setSlot(s)}>
                <b className="mono">{s}</b>
                <div className="tiny muted">{full ? t("slotFull") : left+" "+t("slotsLeft")}</div>
                <div className="bar" style={{marginTop:6}}><i className={left<=2?"hot":left<=5?"mid":""} style={{width:(c?(used/c.perSlot*100):0)+"%"}}/></div>
              </button>
            );
          })}
        </div>
      </div>
      <div className="card">
        <label className="field"><span>{t("expectedQty")}</span>
          <input className="input mono" inputMode="decimal" value={qty} onChange={e=>setQty(e.target.value.replace(/[^\d.]/g,""))} placeholder="0"/></label>
        {err && <div className="notice small" style={{marginBottom:12,borderColor:"var(--bad)",background:"var(--bad-soft)",color:"var(--bad)"}}>{err}</div>}
        <button className="btn block" onClick={confirm}>{t("confirmBooking")}</button>
      </div>
    </div>
  );
}

function LiveQueue({db,setDB,t,lang,active,setTab,toast}){
  const [cid,setCid] = useState(active?active.centreId:(db.centres[0]?db.centres[0].id:""));
  const date = active?active.date:todayISO();
  const c = centreById(db,cid);
  const q = queueFor(db,cid,date);
  const serving = servingToken(db,cid,date);
  const pos = active && active.centreId===cid ?
