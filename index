const farmerById = (db,id) => db.farmers.find(f=>f.id===id);
const slotIdx = s => TIME_SLOTS.indexOf(s);

function queueFor(db, centreId, date){
  return db.bookings
    .filter(b => b.centreId===centreId && b.date===date && ACTIVE.includes(b.status))
    .sort((a,b)=> (slotIdx(a.slot)-slotIdx(b.slot)) || (a.seq-b.seq));
}
function servingToken(db, centreId, date){ return db.serving[centreId+"|"+date] || null; }
function slotCount(db, centreId, date, slot){
  return db.bookings.filter(b=>b.centreId===centreId && b.date===date && b.slot===slot && b.status!=="cancelled").length;
}
function positionOf(db, booking){
  const q = queueFor(db, booking.centreId, booking.date);
  return q.findIndex(b=>b.id===booking.id);
}
function storagePct(c){ return Math.min(100, Math.round((c.storageUsed/c.storageCap)*100)); }

